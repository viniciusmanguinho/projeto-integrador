#include <ESP32Servo.h>

Servo servo;

int ENA = 25;
int IN1 = 26;
int IN2 = 27;

int ENB = 14;
int IN3 = 32;
int IN4 = 33;

int pinoServo = 18;

void setup() {

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  servo.attach(pinoServo);

  // Servo no centro
  servo.write(90);

  // Motores andando na velocidade máxima
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  analogWrite(ENA, 255);
  analogWrite(ENB, 255);

  delay(3000);

  // Motores parados
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);

  delay(1000);

  // Servo para esquerda
  servo.write(45);
  delay(1000);

  // Servo para direita
  servo.write(135);
  delay(1000);

  // Servo para centro
  servo.write(90);
  delay(1000);
}

void loop() {

  // Motores na velocidade máxima
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  analogWrite(ENA, 255);
  analogWrite(ENB, 255);

  delay(3000);

  // Motores parados
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);

  delay(1000);

  // Servo esquerda
  servo.write(45);
  delay(1000);

  // Servo direita
  servo.write(135);
  delay(1000);

  // Servo centro
  servo.write(90);
  delay(1000);
}
