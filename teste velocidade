#include <ESP32Servo.h>

Servo servo;

int N1 = 25;
int N2 = 26;
int N3 = 27;
int N4 = 14;

int pinoServo = 18;

void setup() {

  pinMode(N1, OUTPUT);
  pinMode(N2, OUTPUT);
  pinMode(N3, OUTPUT);
  pinMode(N4, OUTPUT);

  servo.attach(pinoServo);

  // Servo no centro
  servo.write(90);

  // Motores andando
  analogWrite(N1, 150);
  digitalWrite(N2, LOW);

  analogWrite(N3, 150);
  digitalWrite(N4, LOW);

  delay(3000);

  // Motores parados
  analogWrite(N1, 0);
  digitalWrite(N2, LOW);

  analogWrite(N3, 0);
  digitalWrite(N4, LOW);

  delay(1000);

  // Servo para esquerda
  servo.write(45);
  delay(1000);

  // Servo para direita
  servo.write(135);
  delay(1000);

  // Servo para centro
  servo.write(90);
  delay(1000);
}

void loop() {

  // Motores andando
  analogWrite(N1, 150);
  digitalWrite(N2, LOW);

  analogWrite(N3, 150);
  digitalWrite(N4, LOW);

  delay(3000);

  // Motores parados
  analogWrite(N1, 0);
  digitalWrite(N2, LOW);

  analogWrite(N3, 0);
  digitalWrite(N4, LOW);

  delay(1000);

  // Servo esquerda
  servo.write(45);
  delay(1000);

  // Servo direita
  servo.write(135);
  delay(1000);

  // Servo centro
  servo.write(90);
  delay(1000);
}
